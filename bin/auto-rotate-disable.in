#
# $Title: Disable Framework Laptop autorotation $
# $Copyright: 2026 Devin Teske. All rights reserved. $
# $FrauBSD: framework-autorotate-hotkey/bin/auto-rotate-disable.in 2026-10-07 20:32:10 -0700 Devin Teske $
#
############################################################ INFORMATION
#
# Set the autorotate hold and show the off glyph.
#
############################################################ GLOBALS

pgm="${0##*/}" # Program basename

############################################################ FUNCTIONS

usage()
{
	echo "Usage: $pgm" >&2
	exit 1
}

############################################################ MAIN

set -e # errexit

[ $# -gt 0 ] && usage # NOTREACHED

@PREFIX@/sbin/framework_autorotate -hold
auto-rotate-osd off 2 &

################################################################################
# END
################################################################################
