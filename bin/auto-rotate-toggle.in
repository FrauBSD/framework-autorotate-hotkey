############################################################ IDENT(1)
#
# $Title: Toggle autorotate hold and show the glyph $
# $Copyright: 2026 Devin Teske. All rights reserved. $
# $FrauBSD: framework-autorotate-hotkey/bin/auto-rotate-toggle.in 2026-10-07 20:32:20 -0700 Devin Teske $
#
############################################################ INFORMATION
#
# Toggle the autorotate hold and show the matching glyph with
# auto-rotate-osd.
#
# The rotate plugin runs this in the session and at the greeter.
#
# The hold file is under the real uid's passwd home, the same
# place framework_autorotate -hold uses. The greeter runs as
# root, so the file is under ~root. A session uses the login
# user's home. Greeter helpers often set HOME to the login
# user; do not trust $HOME for this check.
#
############################################################ GLOBALS

pgm="${0##*/}" # Program basename

#
# Global exit status
#
SUCCESS=0
FAILURE=1

############################################################ FUNCTIONS

passwd_home()
{
	getent passwd "$1" 2> /dev/null | cut -d: -f6
}

usage()
{
	echo "Usage: $pgm" >&2
	exit $FAILURE
}

############################################################ MAIN

set -e # errexit

[ $# -gt 0 ] && usage # NOTREACHED

uid=$( id -u )
hold_home=$( passwd_home "$uid" ) || hold_home=
if [ ! "$hold_home" ]; then
	if [ "$uid" -eq 0 ]; then
		hold_home=/root
	else
		hold_home="${HOME:-/tmp}"
	fi
fi
hold="$hold_home/.framework_hold_autorotate"

if [ -e "$hold" ]; then
	@PREFIX@/sbin/framework_autorotate -release
	auto-rotate-osd on 2 &
else
	@PREFIX@/sbin/framework_autorotate -hold
	auto-rotate-osd off 2 &
fi

exit $SUCCESS

################################################################################
# END
################################################################################
